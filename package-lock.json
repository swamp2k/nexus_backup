{
  "name": "nexus-backup",
  "version": "0.5.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "nexus-backup",
      "version": "0.5.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/agent": {
      "name": "@nexus-backup/agent",
      "version": "0.5.0",
      "dependencies": {
        "@nexus-backup/core": "*"
      }
    },
    "apps/control-plane": {
      "name": "@nexus-backup/control-plane",
      "version": "0.2.0",
      "dependencies": {
        "@nexus-backup/core": "*"
      }
    },
    "node_modules/@nexus-backup/agent": {
      "resolved": "apps/agent",
      "link": true
    },
    "node_modules/@nexus-backup/control-plane": {
      "resolved": "apps/control-plane",
      "link": true
    },
    "node_modules/@nexus-backup/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/core": {
      "name": "@nexus-backup/core",
      "version": "0.2.0"
    }
  }
}
